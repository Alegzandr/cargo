# Dev image — Node 22 with source bind-mounted from the host.
FROM node:22-alpine
WORKDIR /app
RUN apk add --no-cache libc6-compat
RUN mkdir -p /var/lib/cargo/blobs && chown -R node:node /var/lib/cargo
USER node
EXPOSE 3000
ENV NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000
CMD ["sh", "-c", "if [ ! -d node_modules/next ]; then npm ci; fi && npm run dev"]
