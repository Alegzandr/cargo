# Copy to .env.local for local dev. Values below are placeholders.

# Auth.js — Discord OAuth only.
# Create a Discord application: https://discord.com/developers/applications
# OAuth2 redirect URL for local dev: http://localhost:8080/api/auth/callback/discord
AUTH_SECRET=please-generate-a-long-random-string
AUTH_DISCORD_ID=your-discord-app-client-id
AUTH_DISCORD_SECRET=your-discord-app-client-secret
AUTH_URL=http://localhost:8080
AUTH_TRUST_HOST=true

# Master encryption key — base64-encoded 32 random bytes.
# Generate with:  head -c 32 /dev/urandom | base64
# DO NOT use this placeholder in production. The boot path fails fast on a non-32-byte key.
CARGO_MASTER_KEY=base64:please-replace-with-32-bytes-of-randomness=

# Postgres
DATABASE_URL=postgres://cargo:cargo@db:5432/cargo

# Limits (env-tunable)
CARGO_MAX_FILE_SIZE=214748364800       # 200 GiB per file
CARGO_USER_QUOTA=214748364800          # 200 GiB per user in flight
CARGO_LINK_TTL_SECONDS=3600            # 1 hour
CARGO_PENDING_TTL_SECONDS=86400        # 24 hours (unclaimed transfer cap)

# Storage
CARGO_BLOB_PATH=/var/lib/cargo/blobs

# Logging — production: 'warning'. Dev defaults to 'debug'.
LOG_LEVEL=debug
