APP_SLUG=cargo
APP_SUBDOMAIN=cargo
# Edit these for your own infra. The CI script in .gitlab-ci.yml uses both.
#   DEPLOY_DIR     — where compose files + app.env are written on the deploy host
#   DATA_DIR_BASE  — base path for blobs + postgres + logs.
#                    Per-env DATA_DIR is computed as
#                    "${DATA_DIR_BASE}-d" on develop and "${DATA_DIR_BASE}" on tags.
DEPLOY_DIR=/srv/deploy-cargo
DATA_DIR_BASE=/var/lib/cargo
TRAEFIK_NETWORK=traefik
